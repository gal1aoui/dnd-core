{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@agal1aoui/dnd-core": ["../../packages/core/src/index.ts"],
      "@agal1aoui/react-dnd": ["../../packages/react/src/index.ts"],
      "@agal1aoui/vertical-dnd": ["../../packages/vertical/src/index.ts"],
      "@agal1aoui/horizontal-dnd": ["../../packages/horizontal/src/index.ts"],
      "@agal1aoui/board-dnd": ["../../packages/board/src/index.ts"],
      "@agal1aoui/layout-dnd": ["../../packages/layout/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

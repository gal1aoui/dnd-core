{
  "name": "@agal1aoui/dnd",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight drag-and-drop library for React and Angular",
  "author": "gal1aoui",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @agal1aoui/dnd-core build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean && rimraf node_modules",
    "lint": "eslint packages --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
